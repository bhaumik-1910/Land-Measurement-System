# Dependencies
node_modules/

# Environment files - strictly ignore
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example files
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User uploads (keep folder via .gitkeep)
uploads/*
!uploads/.gitkeep

# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
