# ==========================================
# Backend Environment Variables Template
# ==========================================
# Duplicate this file and rename it to .env
# Fill in your actual credentials below.

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/land_survey_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/land_survey_db?retryWrites=true&w=majority

# JWT Secret Key for token signing (generate a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 Client ID (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Groq API Key for AI features (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
